# ─── Required ─────────────────────────────────────────────
ELEVENLABS_API_KEY=xi_xxxxxxxxxxxxxxxxxxxx
JWT_SECRET=your_long_random_secret_here_minimum_32_chars
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Admin Seed (optional — auto-generated if not set) ────
ADMIN_EMAIL=admin@dialix.ai
ADMIN_PASSWORD=YourSecurePassword123!

# ─── Database (default: SQLite at /data/dialix.db) ────────
DB_PROVIDER=sqlite
# For Postgres, set:
# DB_PROVIDER=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=dialix
# PG_PASSWORD=your_pg_password
# PG_DATABASE=dialix

# ─── Vapi (optional, for Vapi provider support) ───────────
# VAPI_API_KEY=your_vapi_api_key

# ─── Gemini (optional, for Gemini Live provider support) ──
# GOOGLE_API_KEY=your_google_api_key
# GEMINI_MODEL=models/gemini-3.1-flash-live-preview

# ─── Production ──────────────────────────────────────────
# NODE_ENV=production
